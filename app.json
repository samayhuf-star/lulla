{
  "expo": {
    "name": "Lulla - Sleep Sounds",
    "slug": "lulla",
    "scheme": "lulla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#150a2e",
    "ios": {
      "bundleIdentifier": "com.samay.lulla",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.samay.lulla",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#150a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#150a2e",
          "imageWidth": 200
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-asset",
      "expo-build-properties",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "cf050aa6-2a3d-434d-ab15-f142be58d75c"
      },
      "privacyPolicyUrl": "https://momentumbysamay.com/lulla/privacy"
    },
    "owner": "krosz",
    "description": "Lulla plays calming sleep sounds to help you fall asleep and stay asleep."
  }
}
